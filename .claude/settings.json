{
  "env": {
    "EDITOR": "neovide"
  },
  "model": "sonnet",
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "remoteControlAtStartup": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:/Users/ville/myfiles/dotfiles/.claude/hooks/stop-sound.ps1\""
          }
        ]
      }
    ]
  }
}
