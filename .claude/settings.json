{
  "env": {
    "EDITOR": "neovide",
    "IS_DEMO": "1"
  },
  "model": "sonnet",
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "remoteControlAtStartup": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\Windows Print complete.wav').PlaySync()\""
          }
        ]
      }
    ]
  }
}
